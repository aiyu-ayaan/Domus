{
  "name": "domus-root",
  "version": "0.0.1-alpha.3",
  "build": 4,
  "private": true,
  "description": "Domus - Modern smart home assistant platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,web,gateway\" -c \"cyan,magenta,green\" \"pnpm run dev:backend\" \"pnpm run dev:web\" \"pnpm run gateway\"",
    "dev:backend": "cargo run --manifest-path backend/Cargo.toml",
    "dev:web": "pnpm --filter @domus/web dev",
    "gateway": "node scripts/gateway.mjs",
    "android:dev": "bash scripts/android-dev.sh",
    "android:prod": "bash scripts/android-prod.sh",
    "android:release": "(cd apps/android && ./gradlew :app:installProdRelease)",
    "android:profile": "(cd apps/android && ./gradlew :app:generateBaselineProfile -Pandroid.injected.androidTest.leaveApksInstalledAfterRun=true)",
    "android:build:dev": "(cd apps/android && ./gradlew :app:assembleDevDebug)",
    "android:build:prod": "(cd apps/android && ./gradlew :app:assembleProdRelease)",
    "dev:desktop": "pnpm --filter @domus/desktop dev",
    "dev:desktop:prod": "pnpm --filter @domus/desktop dev:prod",
    "build": "pnpm --filter @domus/web build && cargo build --release --manifest-path backend/Cargo.toml",
    "build:web": "pnpm --filter @domus/web build",
    "build:web:dev": "pnpm --filter @domus/web build:dev",
    "build:web:prod": "pnpm --filter @domus/web build:prod",
    "build:desktop": "pnpm --filter @domus/desktop build:prod",
    "build:desktop:dev": "pnpm --filter @domus/desktop build:dev",
    "build:desktop:prod": "pnpm --filter @domus/desktop build:prod",
    "build:backend": "cargo build --release --manifest-path backend/Cargo.toml",
    "lint": "pnpm --filter @domus/web lint && cargo clippy --manifest-path backend/Cargo.toml",
    "test": "cargo test && pnpm --filter @domus/web test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
