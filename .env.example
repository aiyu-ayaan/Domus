# Copy to .env (never commit it). All values are optional.
APP_ENV=development

# Base64 32-byte key that encrypts integration credentials at rest.
# If unset, data/master.key is generated on first start — back it up.
# DOMUS_MASTER_KEY=

# Any config key: DOMUS__<SECTION>__<KEY>
# DOMUS__SERVER__PORT=8443
# DOMUS__TLS__ENABLED=true
# DOMUS__INTEGRATIONS__VIRTUAL__ENABLED=false
