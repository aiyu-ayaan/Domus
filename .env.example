# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_ENV=development

# Database
DATABASE_URL=sqlite://docus.db?mode=rwc

# Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
PASSWORD_SALT=docus-secure-salt-change-me

# MQTT Broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=docus_core_server
MQTT_USERNAME=
MQTT_PASSWORD=

# Integrations
TUYA_ENABLE=true
TAPO_ENABLE=true
XIAOMI_ENABLE=true
