{
  "appId": "com.aiyu.domus",
  "productName": "Domus",
  "executableName": "domus",
  "files": [
    "src/**"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    }
  ],
  "linux": {
    "target": [
      "deb",
      "AppImage"
    ],
    "icon": "build/icon.png",
    "category": "Utility",
    "synopsis": "Smart home control"
  },
  "deb": {
    "packageName": "domus",
    "afterInstall": "build/after-install.sh",
    "artifactName": "domus_${version}_${arch}.${ext}"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "artifactName": "Domus-${version}-Setup.${ext}"
  }
}
