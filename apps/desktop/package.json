{
  "name": "@docus/desktop",
  "productName": "Docus",
  "desktopName": "docus.desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Docus smart home, desktop app",
  "author": "Docus Team <ayaan35200@gmail.com>",
  "homepage": "https://github.com/docus/docus",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "DOCUS_FLAVOR=dev electron . --no-sandbox",
    "dev:prod": "DOCUS_FLAVOR=prod electron . --no-sandbox",
    "build": "pnpm run build:prod",
    "build:prod": "electron-builder --linux --config electron-builder.prod.json",
    "build:dev": "electron-builder --linux --config electron-builder.dev.json",
    "build:win": "electron-builder --win --config electron-builder.prod.json"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
