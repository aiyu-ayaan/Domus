{
  "name": "@domus/desktop",
  "productName": "Domus",
  "desktopName": "domus.desktop",
  "version": "0.0.1-alpha.5",
  "private": true,
  "description": "Domus smart home, desktop app",
  "author": "Domus Team <ayaan35200@gmail.com>",
  "homepage": "https://github.com/aiyu-ayaan/Domus-Rust",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "DOMUS_FLAVOR=dev electron . --no-sandbox",
    "dev:prod": "DOMUS_FLAVOR=prod electron . --no-sandbox",
    "build": "pnpm run build:prod",
    "build:prod": "electron-builder --linux --config electron-builder.prod.json",
    "build:dev": "electron-builder --linux --config electron-builder.dev.json",
    "build:win": "electron-builder --win --config electron-builder.prod.json"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
