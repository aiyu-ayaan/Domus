{
  "name": "@docus/desktop",
  "productName": "Docus",
  "desktopName": "docus.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Docus smart home, desktop app",
  "author": "Docus Team <ayaan35200@gmail.com>",
  "homepage": "https://github.com/docus/docus",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "build": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aiyu.domus",
    "productName": "Docus",
    "executableName": "docus",
    "files": ["src/**"],
    "extraResources": [{ "from": "build/icon.png", "to": "icon.png" }],
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Smart home control"
    }
  }
}
