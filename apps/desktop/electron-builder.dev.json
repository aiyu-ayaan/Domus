{
  "appId": "com.aiyu.domus.dev",
  "productName": "Domus Dev",
  "executableName": "domus-dev",
  "files": ["src/**"],
  "extraResources": [
    { "from": "build/icon-dev.png", "to": "icon-dev.png" },
    { "from": "build/icon-dev.png", "to": "icon.png" }
  ],
  "linux": {
    "target": ["deb", "AppImage"],
    "icon": "build/icon-dev.png",
    "category": "Utility",
    "synopsis": "Smart home control (Development)"
  },
  "deb": {
    "packageName": "domus-dev",
    "afterInstall": "build/after-install.sh",
    "artifactName": "domus-dev_${version}_${arch}.${ext}"
  }
}
