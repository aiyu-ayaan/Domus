<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash plays the animated mark on the canvas colour. -->
    <style name="Theme.Domus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">980</item>
    </style>
</resources>
