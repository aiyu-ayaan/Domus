{
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "liquid-glass@liquid-glass-skills": true,
    "material-3@material-3-skill": true,
    "logo-design@logo-design-skill": true
  }
}
